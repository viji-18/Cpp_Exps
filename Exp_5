#include <iostream>
#include <vector>
#include <algorithm>
#include <numeric>
#include <string>

using namespace std;

class Student
{
public:
    string name;
    int mark;
    char grade;
};

void analyzeStudents(vector<Student> students)
{
    // Sort students based on marks
    sort(students.begin(), students.end(),
    [](Student a, Student b)
    {
        return a.mark > b.mark;
    });

    // Assign grades using transform
    transform(students.begin(), students.end(),
              students.begin(),
    [](Student s)
    {
        if (s.mark >= 90)
            s.grade = 'A';
        else if (s.mark >= 75)
            s.grade = 'B';
        else if (s.mark >= 50)
            s.grade = 'C';
        else
            s.grade = 'F';

        return s;
    });

    // Find first student scoring above 80
    auto it = find_if(students.begin(), students.end(),
    [](Student s)
    {
        return s.mark > 80;
    });

    // Calculate total marks
    int total = accumulate(students.begin(), students.end(), 0,
    [](int sum, Student s)
    {
        return sum + s.mark;
    });

    float average = (float)total / students.size();

    // Display results
    cout << "Student Grade Analyzer\n";
    cout << "----------------------\n";
    cout << "Name\tMark\tGrade\n";

    for (Student s : students)
    {
        cout << s.name << "\t"
             << s.mark << "\t"
             << s.grade << endl;
    }

    if (it != students.end())
    {
        cout << "\nFirst student scoring above 80: "
             << it->name << endl;
    }
    else
    {
        cout << "\nNo student scored above 80.\n";
    }

    cout << "Total Marks: " << total << endl;
    cout << "Average Mark: " << average << endl;
}

int main()
{
    // TEST CASE 1
    vector<Student> students1 = {
        {"Arun", 85, ' '},
        {"Bala", 72, ' '},
        {"Kumar", 91, ' '},
        {"Ravi", 65, ' '}
    };

    cout << "\n===== TEST CASE 1 =====\n";
    analyzeStudents(students1);

    // TEST CASE 2
    vector<Student> students2 = {
        {"Priya", 45, ' '},
        {"Divya", 78, ' '},
        {"Anu", 95, ' '},
        {"Ram", 60, ' '}
    };

    cout << "\n===== TEST CASE 2 =====\n";
    analyzeStudents(students2);

    return 0;
}
